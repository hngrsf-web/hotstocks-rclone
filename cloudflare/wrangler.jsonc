{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ugreen-trading-control-cloud",
  "main": "src/index.js",
  "compatibility_date": "2026-09-20",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "CLOUD_USER": "trading",
    "STALE_MINUTES": "10"
  }
}
