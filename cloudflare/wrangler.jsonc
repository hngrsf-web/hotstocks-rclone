{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ugreen-trading-control-cloud",
  "main": "src/index.js",
  "compatibility_date": "2026-09-20",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "kv_namespaces": [
    {
      "binding": "SNAPSHOT_KV",
      "id": "6ccf797c14704643a023169a85b65d08"
    }
  ],
  "vars": {
    "CLOUD_USER": "trading",
    "STALE_MINUTES": "10"
  }
}
